# Fipro environment template.
#
# Fipro is a local-first CLI tool. No environment variables are required for the
# MVP pipeline. This file documents future slots and keeps .env.example present
# for tooling that expects it.
#
# Usage: copy to .env and fill in as needed.
#   cp .env.example .env

# Path to Google service account credentials for `fipro sheets` export.
# If unset, the CLI default `config/google_credentials.json` is used.
# GOOGLE_APPLICATION_CREDENTIALS=

# Passwords for password-protected (encrypted) .xls/.xlsx statements.
# Per bank (HDFC, SBI, AXIS) takes precedence over the shared fallback.
# Export them in your shell; fipro does not read this file automatically.
# FIPRO_SBI_STATEMENT_PASSWORD=
# FIPRO_STATEMENT_PASSWORD=

# Default log level for fipro CLI. Overrides config.toml [fipro].log_level.
# FIPRO_LOG_LEVEL=INFO
